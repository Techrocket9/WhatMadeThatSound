<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Registered by the app with SMAppService.agent(plistName:). launchd starts the
	     agent at login and restarts it if it ever exits while registered. -->
	<key>Label</key>
	<string>com.matthewy.WhatMadeThatSound.Agent</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/WhatMadeThatSoundAgent</string>
	<key>ProgramArguments</key>
	<array>
		<string>WhatMadeThatSoundAgent</string>
		<string>run</string>
	</array>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.matthewy.WhatMadeThatSound</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>ProcessType</key>
	<string>Standard</string>
</dict>
</plist>
